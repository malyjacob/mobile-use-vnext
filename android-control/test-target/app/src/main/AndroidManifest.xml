<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mobileuse.probe"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="36" android:targetSdkVersion="36" />

    <!-- 受控前台播放验证需要 mediaPlayback 前台服务；通知权限缺失时系统只隐藏通知。 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="false"
        android:debuggable="true">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 独立 taskAffinity 允许以 FLAG_ACTIVITY_NEW_TASK 形成第二任务。 -->
        <activity
            android:name=".ProbeSecondActivity"
            android:exported="true"
            android:taskAffinity="com.mobileuse.probe.second" />
        <!-- :remote 进程与独立 taskAffinity：验证跨进程页面与第二任务。 -->
        <activity
            android:name=".ProbeRemoteActivity"
            android:exported="true"
            android:process=":remote"
            android:taskAffinity="com.mobileuse.probe.remote" />
        <service
            android:name=".ProbePlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>
</manifest>
