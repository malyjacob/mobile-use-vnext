<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:padding="24dp"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#111827"
            android:accessibilityHeading="true" />
        <TextView android:id="@+id/version" style="@style/DetailText" />
        <TextView style="@style/DetailText" android:text="@string/capability_notice" />

        <TextView style="@style/SectionTitle" android:text="@string/control_view_title"
            android:accessibilityHeading="true" />
        <TextView android:id="@+id/control_primary" style="@style/StatusText"
            android:text="@string/session_standby" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/control_detail" style="@style/DetailText" />

        <TextView style="@style/SectionTitle" android:text="@string/mode_title"
            android:accessibilityHeading="true" />
        <TextView android:id="@+id/mode_status" style="@style/StatusText"
            android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/mode_detail" style="@style/DetailText" />
        <Button android:id="@+id/select_primary"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/use_primary" />
        <Button android:id="@+id/select_virtual"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/use_virtual" />

        <TextView style="@style/SectionTitle" android:text="@string/message_center_title"
            android:accessibilityHeading="true" />
        <Button android:id="@+id/open_messages"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/message_center_empty_button" />
        <TextView android:id="@+id/message_status" style="@style/DetailText"
            android:accessibilityLiveRegion="polite" />

        <TextView style="@style/SectionTitle" android:text="@string/background_title"
            android:accessibilityHeading="true" />
        <TextView android:id="@+id/background_status" style="@style/StatusText"
            android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/notification_status" style="@style/DetailText" />
        <TextView android:id="@+id/overlay_status" style="@style/DetailText" />
        <TextView android:id="@+id/stop_status" style="@style/DetailText" />
        <TextView android:id="@+id/stop_sync" style="@style/DetailText"
            android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/start_background"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/start_background" />
        <Button android:id="@+id/grant_notifications"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/grant_notifications" />
        <Button android:id="@+id/notification_settings"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/notification_settings" />
        <Button android:id="@+id/overlay_settings"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="48dp" android:text="@string/overlay_settings" />
        <Button android:id="@+id/stop"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="56dp" android:text="@string/stop_operation"
            android:textColor="#B91C1C" />

        <TextView style="@style/SectionTitle" android:text="@string/display_title"
            android:accessibilityHeading="true" />
        <TextView android:id="@+id/virtual_display_status" style="@style/DetailText" />

        <TextView style="@style/SectionTitle" android:text="@string/service_title"
            android:accessibilityHeading="true" />
        <TextView android:id="@+id/service_status" style="@style/StatusText"
            android:text="@string/connecting" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/service_detail" style="@style/DetailText"
            android:text="@string/waiting_for_status" />

        <TextView style="@style/SectionTitle" android:text="@string/last_sync_label" />
        <TextView android:id="@+id/last_sync" style="@style/FieldValue"
            android:text="@string/never_synced" />
    </LinearLayout>
</ScrollView>
