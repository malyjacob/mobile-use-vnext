<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="@drawable/overlay_ball_background"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackgroundBorderless"
    android:elevation="6dp"
    android:contentDescription="Agent 状态，点击展开">

    <TextView
        android:id="@+id/overlay_compact_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="4dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:ellipsize="end"
        android:text="运行中"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/overlay_compact_unread"
        android:layout_width="wrap_content"
        android:layout_height="16dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="2dp"
        android:minWidth="16dp"
        android:maxWidth="24dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:paddingHorizontal="3dp"
        android:background="@drawable/overlay_compact_badge_background"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
